{
  "name": "cell-arena",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive cell and tumor microenvironment simulation powered by Artistoo, WebAssembly and GPU rendering.",
  "homepage": "https://coolcoldplay.github.io/Cell-Arena/",
  "repository": {"type": "git", "url": "https://github.com/coolcoldplay/Cell-Arena.git"},
  "engines": {"node": ">=24"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:publication": "node scripts/check-publication.mjs",
    "test:browser": "node scripts/check-scenarios.mjs",
    "test:interactions": "node scripts/check-v4.mjs",
    "probe:scenarios": "node scripts/probe-scenarios.mjs",
    "test:display": "node scripts/check-display-v4.mjs",
    "test:morphology": "node scripts/check-morphology-colors.mjs",
    "test:deaths": "node scripts/check-death-palettes.mjs",
    "test:death-drag": "node scripts/check-death-drag.mjs",
    "test:workbench": "node scripts/check-workbench.mjs",
    "test:sharing": "node scripts/check-sharing.mjs",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:arena-lab": "node scripts/check-arena-lab.mjs",
    "test:video": "node scripts/check-video.mjs",
    "test:surveillance": "node scripts/check-surveillance.mjs",
    "test:cell-cycle": "node --test tests/cell-cycle.test.mjs",
    "test:cycle-browser": "node scripts/check-cell-cycle.mjs",
    "test:cycle-gpu": "node scripts/check-cycle-gpu.mjs",
    "test:gpu": "node scripts/check-gpu-v4.mjs",
    "test:hires": "node scripts/check-hires-interaction.mjs",
    "benchmark": "node scripts/benchmark-v4.mjs",
    "test:performance": "node scripts/check-performance.mjs",
    "test:adaptive": "node scripts/check-adaptive.mjs",
    "test:history": "node scripts/check-history.mjs",
    "test:support-nuclei": "node scripts/check-support-nuclei.mjs",
    "benchmark:adaptive": "node scripts/benchmark-adaptive.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "benchmark:browser": "node scripts/benchmark-browser-performance.mjs"
  }
}
